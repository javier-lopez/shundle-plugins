#msdos.ps

_msdos_pwd()
{   #pwd | sed 's:/:\\:g' was two processes per prompt to swap one character
    _MSDOS_PWD=""
    _msdos_pwd__r="${PWD#/}"
    while [ -n "${_msdos_pwd__r}" ]; do
        case "${_msdos_pwd__r}" in
            */*) _MSDOS_PWD="${_MSDOS_PWD}\\${_msdos_pwd__r%%/*}"
                 _msdos_pwd__r="${_msdos_pwd__r#*/}" ;;
            *)   _MSDOS_PWD="${_MSDOS_PWD}\\${_msdos_pwd__r}"
                 _msdos_pwd__r="" ;;
        esac
    done
    [ -z "${_MSDOS_PWD}" ] && _MSDOS_PWD="\\"
}

_cz_hook _msdos_pwd
_msdos_pwd

PS1="C:\${_MSDOS_PWD}\\> "

