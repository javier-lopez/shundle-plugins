#zork.ps

#taken from bashit, https://github.com/revans/bash-it
#
#It used to be 512 lines: a whole colour DSL producing eight colours the core
#already has, an scm layer that detected git, hg and svn, and three Ruby
#version detectors. None of it ran per prompt — PS1 was built once, in double
#quotes, so the branch and its state froze at the shell's startup: standing in
#/tmp it still claimed you were on a clean main.

SCM_GIT_CHAR='±'
SCM_THEME_PROMPT_DIRTY=" $(_cz_color '31;1')✗${_CZ_RESET}"
SCM_THEME_PROMPT_CLEAN=" $(_cz_color '32;1')✓${_CZ_RESET}"

_zork_scm()
{   #the scm block is two brackets and both disappear outside a repo, so this
    #one assembles them from the pieces instead of taking the composed _CZ_GIT
    _ZORK_SCM=""
    [ -z "${_CZ_GIT_NAME}" ] && return 0

    #_CZ_GIT_DIRTY only knows under COLORIZE_GITPROMPT=dirty; with anything
    #else the theme shows the branch and says nothing about its state, which
    #is the honest answer when nobody ran git
    if [ X"${COLORIZE_GITPROMPT}" = X"dirty" ]; then
        [ -n "${_CZ_GIT_DIRTY}" ] &&
            _zork_scm__state="${SCM_THEME_PROMPT_DIRTY}" ||
            _zork_scm__state="${SCM_THEME_PROMPT_CLEAN}"
    else
        _zork_scm__state=""
    fi

    _ZORK_SCM="[$(_cz_color '32;1')${SCM_GIT_CHAR}${_CZ_RESET}][${_CZ_GIT_NAME}${_zork_scm__state}]"
}

#$VIMRUNTIME is an environment variable: it costs nothing and it cannot go stale
[ -n "${VIMRUNTIME}" ] && _zork_vim="[$(_cz_color '0;36')vim shell${_CZ_RESET}]" || _zork_vim=""

_cz_use git ssh elapsed
_cz_hook _zork_scm

case "${HOSTNAME}" in
    pandora) _zork_host="${_CZ_RED}\h${_CZ_RESET}" ;;
    *)       _zork_host="$(_cz_color '0;32')\h${_CZ_RESET}" ;;
esac

[ -n "${_CZ_ROOT}" ] &&
    _zork_user="$(_cz_color '01;31')\u$(_cz_color '00')" ||
    _zork_user="$(_cz_color '01;32')\u$(_cz_color '00')"

PS1="┌─[\${_CZ_SSH}${_zork_user}][${_zork_host}]\${_ZORK_SCM}[$(_cz_color '0;36')\w${_CZ_RESET}]${_zork_vim}\${_CZ_ELAPSED}
└─▪ "
PS2="└─▪ "

# vim: set ts=8 sw=4 tw=0 ft=sh :
