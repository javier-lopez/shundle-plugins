#powerline

#https://github.com/riobard/bash-powerline
__powerline() {
    # Unicode symbols
    PS_SYMBOL_DARWIN=''
    PS_SYMBOL_LINUX='$'
    PS_SYMBOL_OTHER='%'
    GIT_BRANCH_SYMBOL='⑂ '
    GIT_BRANCH_CHANGED_SYMBOL='+'
    GIT_NEED_PUSH_SYMBOL='⇡'
    GIT_NEED_PULL_SYMBOL='⇣'

    # Solarized colorscheme. tput and not the core palette: these are 256-colour
    # slots, and only terminfo knows how this terminal spells them. They are
    # constants, so the cost is once per shell and not once per prompt
    FG_BASE3="\[$(tput setaf 15)\]"

    BG_BLUE="\[$(tput setab 4)\]"
    BG_CYAN="\[$(tput setab 6)\]"
    BG_RED="\[$(tput setab 1)\]"
    BG_GREEN="\[$(tput setab 2)\]"

    RESET="\[$(tput sgr0)\]"

    # what OS?
    case "$(uname)" in
        Darwin) PS_SYMBOL=$PS_SYMBOL_DARWIN ;;
        Linux)  PS_SYMBOL=$PS_SYMBOL_LINUX  ;;
        *)      PS_SYMBOL=$PS_SYMBOL_OTHER
    esac

    # the branch, the dirty flag and the distance to the remote all come from
    # the core: one .git/HEAD read, and a single git status only when you asked
    # for COLORIZE_GITPROMPT=dirty. This used to be four git processes, and
    # they ran once ever, because PS1 was built at startup and never again
    __git_info() {
        [ -z "$_CZ_GIT_NAME" ] && return
        local marks=""
        [ -n "$_CZ_GIT_DIRTY" ]  && marks="$marks $GIT_BRANCH_CHANGED_SYMBOL"
        [ -n "$_CZ_GIT_AHEAD" ]  && marks="$marks $GIT_NEED_PUSH_SYMBOL$_CZ_GIT_AHEAD"
        [ -n "$_CZ_GIT_BEHIND" ] && marks="$marks $GIT_NEED_PULL_SYMBOL$_CZ_GIT_BEHIND"
        printf " $GIT_BRANCH_SYMBOL$_CZ_GIT_NAME$marks "
    }

    _ps1() {
        # the exit code decides the colour of the last block. _CZ_STATUS is
        # already computed when this runs, and it is the only entry that still
        # saw the status of what you ran
        local BG_EXIT="$BG_GREEN"
        [ X"$_CZ_STATUS" = X"0" ] || BG_EXIT="$BG_RED"

        PS1="$BG_BLUE$FG_BASE3 \w $RESET"
        PS1+="$BG_CYAN$FG_BASE3$(__git_info)$RESET"
        PS1+="$BG_EXIT$FG_BASE3 $PS_SYMBOL $RESET "
    }

    # the exit colour and the branch are per prompt, not per shell
    _CZ_OK="" _CZ_ERR=""
    _cz_use status git
    _cz_hook _ps1
    _ps1
}

__powerline
# vim: set ts=8 sw=4 tw=0 ft=sh :
