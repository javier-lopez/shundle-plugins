#magic.ps, https://bbs.archlinux.org/viewtopic.php?pid=1505273

_magic_next() {
    #change 1 to 0 for darker colors
    _magic_color=$(( ${_magic_color:-0} + 1 ))
    _magic_color=$(( 30 + _magic_color % 8 ))
    printf "%b" "\e[1;${_magic_color}m"
}

#not PROMPT_COMMAND by hand: _cz_hook keeps the core's entry first, which is
#the only one that still sees the exit status of what you just ran
_cz_hook _magic_next

PS1="\$${_CZ_RESET} "

