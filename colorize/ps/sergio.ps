#sergio.ps

#On an idea (and using much of the basics from) Sergio Vale e Pace.
#Created 8 January 99.
#
#Stuff that only needs to be done once:

PromUserName="${USER:-$(whoami)}"
PromCurTTY="$(tty)"; PromCurTTY="${PromCurTTY##*tty}"
PromHostName="${HOSTNAME%%.*}"

#raw escapes on purpose, no palette here: everything up to PromLIGHT_CYAN
#lives inside one \[ ... \] pair, and the \001/\002 the palette carries would
#be nested markers inside it
PromWHITE="\033[1;37m"
PromBLUE_BACK="\033[44m"
PromYELLOW="\033[1;33m"
PromLIGHT_GREEN="\033[1;32m"
PromLIGHT_CYAN="\033[1;36m"
PromNO_COLOUR="\033[0m"

prompt_command() {
   #   Enter your preferred date format here:
   printf -v PromCurDate '%(%H%M)T' -1 2>/dev/null || PromCurDate="$(date "+%H%M")"
   PromCurDateLoc=$(( ${COLUMNS:-0} - ${#PromCurDate} ))

   #${#string} instead of printf | wc -c | tr: the same length, and it counts
   #characters rather than bytes, which is what a column position wanted
   local BarText=" $PromUserName@$PromHostName:$PromCurTTY ${PWD} ${PromCurDate} "
   if [ -n "${COLUMNS}" ] && [ "${#BarText}" -gt "${COLUMNS}" ]; then
      #   Why do I need to add 5 not 3 (the number of dots) here?
      PromNewPWD="...${PWD:$(( ${#BarText} - COLUMNS + 5 ))}"
   else
      PromNewPWD="${PWD}"
   fi
}

#it used to be PROMPT_COMMAND=prompt_command, which threw away whatever the
#core and the other plugins had already put there
_cz_hook prompt_command

#   Because most of the action goes on in the blue bar at the top of the
#   screen, which is already considered to be a "non-printing" area by the
#   prompt, the local COLOURs don't have to be surrounded by \[ and \] .

sergio() {
PS1="\[\033[s\
\033[H\033[K\
$PromBLUE_BACK$PromWHITE\
 \$PromUserName@\$PromHostName:\$PromCurTTY \
$PromLIGHT_GREEN\$PromNewPWD\033[K  \
\033[0;\${PromCurDateLoc}H$PromYELLOW\${PromCurDate} \
\033[K\
\033[u\033[1A\033[1B\
$PromLIGHT_CYAN\]>\[$PromNO_COLOUR\] "

PS2="\[$PromLIGHT_CYAN\]-\[$PromNO_COLOUR\] "
}

sergio

