# modern: the newer tools, wearing the colour theme, and only if they are here

#This set defines no alias on purpose: naming commands is
#[aliazator](https://github.com/javier-lopez/shundle-plugins/tree/master/aliazator)'s
#job, and two plugins fighting over `ls` is how a shell stops being yours.
#What lives here is the environment those tools read — and every colour in it
#comes from colorize's slot numbers, so eza, bat and delta follow the same
#.theme the prompt does.
#
#Nothing is installed from here either: a static binary is a per-machine
#decision. Fetch them from your own shundle configuration with a PostInstall
#line, the way fzf is fetched. Whatever is missing simply leaves its variable
#unset and the classic tool keeps working.

#the classics first: this set ADDS to them. LS_COLORS, GREP_COLOR and less's
#capabilities still matter — eza falls back to LS_COLORS for anything it does
#not name, and plain ls is what you get on a machine without eza
[ -z "${COLORIZE_UTILS_BASE}" ] && COLORIZE_UTILS_BASE="sky"
[ -f "${COLORIZE_PATH}/utils/${COLORIZE_UTILS_BASE}.utils" ] &&
    . "${COLORIZE_PATH}/utils/${COLORIZE_UTILS_BASE}.utils"

#the same palette as the prompt, with the ANSI defaults if core was not sourced
_mu_ok="${_CZ_N_OK:-2}"     ; _mu_err="${_CZ_N_ERR:-1}"
_mu_accent="${_CZ_N_ACCENT:-3}"
_mu_user="${_CZ_N_USER:-4}" ; _mu_dim="${_CZ_N_DIM:-8}"

#-------------------------------------------------------------------------------
# eza — ls with a git column
#-------------------------------------------------------------------------------
if command -v eza >/dev/null 2>&1; then
    #EZA_COLORS is LS_COLORS plus eza's own keys; anything not named here falls
    #back to LS_COLORS, which the ps theme's utils set already filled in
    EZA_COLORS="ur=3${_mu_accent}:uw=3${_mu_err}:ux=3${_mu_ok}:ue=3${_mu_ok}"
    EZA_COLORS="${EZA_COLORS}:gr=3${_mu_accent}:gw=3${_mu_err}:gx=3${_mu_ok}"
    EZA_COLORS="${EZA_COLORS}:tr=3${_mu_accent}:tw=3${_mu_err}:tx=3${_mu_ok}"
    EZA_COLORS="${EZA_COLORS}:da=3${_mu_dim}:uu=3${_mu_user}:un=3${_mu_dim}"
    EZA_COLORS="${EZA_COLORS}:ga=3${_mu_ok}:gm=3${_mu_accent}:gd=3${_mu_err}"
    export EZA_COLORS
fi

#-------------------------------------------------------------------------------
# bat — cat and man with syntax highlighting
#-------------------------------------------------------------------------------
if command -v bat >/dev/null 2>&1; then
    _mu_bat="bat"
elif command -v batcat >/dev/null 2>&1; then
    _mu_bat="batcat"    #Debian ships it under another name, bat is taken
else
    _mu_bat=""
fi

if [ -n "${_mu_bat}" ]; then
    #"ansi", and not one of bat's own palettes, for the same reason the prompt
    #is written in slots: it is the only theme that follows the colours your
    #.theme set instead of painting over them
    [ -z "${BAT_THEME}" ] && export BAT_THEME="ansi"
    export MANPAGER="sh -c 'col -bx | ${_mu_bat} -l man -p'"
    export MANROFFOPT="-c"
fi

#-------------------------------------------------------------------------------
# delta — git diffs you can read
#-------------------------------------------------------------------------------
if command -v delta >/dev/null 2>&1; then
    #git's own config would be the place, but that is a file this plugin does
    #not own. The environment reaches the same pager and leaves your
    #.gitconfig alone
    export GIT_PAGER="delta"
    export DELTA_FEATURES="+"
    [ -z "${DELTA_PAGER}" ] && export DELTA_PAGER="less -R"
fi

#-------------------------------------------------------------------------------
# rg / fd — what they honour is what everything else does
#-------------------------------------------------------------------------------
if command -v rg >/dev/null 2>&1; then
    [ -z "${RIPGREP_CONFIG_PATH}" ] &&
        [ -f "${HOME}/.ripgreprc" ] && export RIPGREP_CONFIG_PATH="${HOME}/.ripgreprc"
fi

unset _mu_ok _mu_err _mu_path _mu_accent _mu_user _mu_dim _mu_bat

# vim: set ts=8 sw=4 tw=0 ft=sh :
