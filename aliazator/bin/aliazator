#!/bin/sh

_basename()
{
    [ -z "${1}" ] && return 1 || _basename__name="${1}"
    [ -z "${2}" ] || _basename__suffix="${2}"
    case "${_basename__name}" in
        /*|*/*) _basename__name="${_basename__name##*/}"
    esac

    if [ -n "${_basename__suffix}" ] && [ "${#_basename__name}" -gt "${#2}" ]; then
        _basename__name="${_basename__name%$_basename__suffix}"
    fi

    retval="${_basename__name}"
    #printf "%s" "${_basename__name}"
}

_usage()
{
    printf "%s\\n" "Usage: aliazator OPTION [ARGS]"
    printf "\\n"
    printf "%s\\n" "  enable  [subset]  enable plugin"
    printf "%s\\n" "  disable [subset]  disable plugins"
    printf "%s\\n" "  list    [subset]  list available plugins"
    printf "%s\\n" "  search  [pattern] look up where an alias is been sourced from, or if's managed by aliazator"
    printf "%s\\n" "  stats   [subset]  count how often aliases are used in the shell history"
    printf "%s\\n" "  suggest [n]       propose aliases for the repeated commands that have none"
    printf "%s\\n" "  teach   [n]       show an alias you have loaded and never used"
    return 1
}

_aliazator_list()
{
    _aliazator_list__aplugin="none,minimal,installed,all"

    _aliazator_list_meta()
    {
        [ -z "${ALIAZATOR_PLUGINS}" ] && ALIAZATOR_PLUGINS="${ALIAZATOR_CACHE}"
        while [ "${_aliazator_list__aplugin}" ]; do
            _aliazator_list__option="${_aliazator_list__aplugin%%,*}"
            if [ X"${ALIAZATOR_PLUGINS}" = X"${_aliazator_list__option}" ]; then
                printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_RED}" " +${_aliazator_list__option}" "${_BIN_SHUNDLE_ENV_NORMAL}"
            else
                printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_YELLOW}" "  ${_aliazator_list__option}" "${_BIN_SHUNDLE_ENV_NORMAL}"
            fi
            [ X"${_aliazator_list__aplugin}" = X"${_aliazator_list__option}" ] && \
                _aliazator_list__aplugin='' || _aliazator_list__aplugin="${_aliazator_list__aplugin#*,}"
        done
    }

    _aliazator_list_sourced()
    {
        [ -z "${1}" ] && return 1
        _aliazator_list_sourced__l="${ALIAZATOR_PLUGINS_ARRAY}"
        while [ "${_aliazator_list_sourced__l}" ]; do
            _aliazator_list_sourced__option="${_aliazator_list_sourced__l%%,*}"
            [ X"${1}" = X"${_aliazator_list_sourced__option}" ] && return 0
            [ X"${_aliazator_list_sourced__l}" = X"${_aliazator_list_sourced__option}" ] &&\
                _aliazator_list_sourced__l='' || _aliazator_list_sourced__l="${_aliazator_list_sourced__l#*,}"
        done
        return 1
    }

    if [ -z "${1}" ]; then
        printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_BLUE}" "meta" "${_BIN_SHUNDLE_ENV_NORMAL}"
        _aliazator_list_meta

        printf "\\n"
        printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_BLUE}" "sets" "${_BIN_SHUNDLE_ENV_NORMAL}"
        for aliases in "${ALIAZATOR_PATH}"/default/*; do
            _basename "${aliases}" .aliases && baliases="${retval}"
            if _aliazator_list_sourced "${baliases}"; then
                printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_RED}" " +${baliases}" "${_BIN_SHUNDLE_ENV_NORMAL}"
            else
                printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_YELLOW}" "  ${baliases}" "${_BIN_SHUNDLE_ENV_NORMAL}"
            fi
        done

        printf "\\n"
        for aliases in "${ALIAZATOR_PATH}"/extra/*; do
            _basename "${aliases}" .aliases && baliases="${retval}"
            if _aliazator_list_sourced "${baliases}"; then
                printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_RED}" " +${baliases}" "${_BIN_SHUNDLE_ENV_NORMAL}"
            else
                printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_YELLOW}" "  ${baliases}" "${_BIN_SHUNDLE_ENV_NORMAL}"
            fi
        done
    else
        [ -f "${ALIAZATOR_PATH}/extra/${1}.aliases" ] && { cat "${ALIAZATOR_PATH}/extra/${1}.aliases"; return 0; }
        [ -f "${ALIAZATOR_PATH}/default/${1}.aliases" ] && { cat "${ALIAZATOR_PATH}/default/${1}.aliases"; return 0; }
    fi
}

_aliazator_disable()
{
    _aliazator_desource()
    {
        [ -z "${1}" ] && return
        _basename "${1}" .aliases && _aliazator_desource__plugin="${retval}"
        ALIAZATOR_PLUGINS_ARRAY="$(printf "%s" "${ALIAZATOR_PLUGINS_ARRAY}"|sed -e "s:${_aliazator_desource__plugin},::g")"
        #TODO 01-11-2013 04:35 >> avoid using files
        sed -e "s:\<alias:unalias:g" -e "s:=.*::g" "${1}" > /tmp/"${_aliazator_desource__plugin}".disable
        . /tmp/"${_aliazator_desource__plugin}".disable >/dev/null 2>&1
        \rm -f /tmp/"${_aliazator_desource__plugin}".disable
    }

    case "${1}" in
        minimal)
            for aliases in "${ALIAZATOR_PATH}"/default/*; do
                _basename "${aliases}" .aliases
                case "${retval}" in
                    general|zcustom|${OSTYPE}) [ -f "${aliases}" ] && _aliazator_desource "${aliases}" ;;
                    osx) #special case, OSTYPE returns string + version on osx systems, wtf
                        case "${OSTYPE}" in darwin*) [ -f "${aliases}" ] && _aliazator_desource "${aliases}".aliases;; esac ;;
                esac
            done
            ;;
        installed)
            _aliazator_disable minimal
            for aliases in "${ALIAZATOR_PATH}"/extra/*; do
                _basename "${aliases}" .aliases
                case "${retval}" in
                    *)
                        if type "${retval}" 1> /dev/null 2>&1; then
                            _aliazator_desource "${aliases}"
                        fi
                        ;;
                esac done
            ;;
        all)
            _aliazator_disable minimal
            for aliases in "${ALIAZATOR_PATH}"/extra/*; do
                _basename "${aliases}" .aliases
                case "${retval}" in
                    *) [ -f "${aliases}" ] && _aliazator_desource "${aliases}" ;;
                esac
            done
            ;;
        *)
            [ -f "${ALIAZATOR_PATH}/extra/${1}.aliases" ]   && { _aliazator_desource "${ALIAZATOR_PATH}/extra/${1}.aliases";   return 0; }
            [ -f "${ALIAZATOR_PATH}/default/${1}.aliases" ] && { _aliazator_desource "${ALIAZATOR_PATH}/default/${1}.aliases"; return 0; }
        ;;
    esac
}

_aliazator_search()
{
    [ "${#}" -lt "1" ] && _usage
    grep -rin "${1}" "${ALIAZATOR_PATH}"
}

_aliazator_stats()
{   #how often aliases show up in the shell history: every command position
    #counts ("ga . && gcm x | less" -> ga, gcm, less), and so does the word
    #after sudo. Without arguments: used/defined per set (+ = loaded); with a
    #set: every alias of it, most used first
    _aliazator_stats__history="${ETERNALIZE_PATH}"
    [ -r "${_aliazator_stats__history}" ] || _aliazator_stats__history="${HISTFILE:-${HOME}/.bash_history}"
    if [ ! -r "${_aliazator_stats__history}" ]; then
        printf "%s\\n" "aliazator: no readable history (ETERNALIZE_PATH or HISTFILE)" >&2
        return 1
    fi

    if [ -n "${1}" ]; then
        _aliazator_stats__files="${ALIAZATOR_PATH}/extra/${1}.aliases"
        [ -f "${_aliazator_stats__files}" ] || _aliazator_stats__files="${ALIAZATOR_PATH}/default/${1}.aliases"
        if [ ! -f "${_aliazator_stats__files}" ]; then
            printf "%s\\n" "aliazator: no '${1}' set" >&2
            return 1
        fi
        set -- "${_aliazator_stats__files}"
    else
        set -- "${ALIAZATOR_PATH}"/default/*.aliases "${ALIAZATOR_PATH}"/extra/*.aliases
    fi

    printf "%s\\n" "history: ${_aliazator_stats__history}"
    awk -v hist="${_aliazator_stats__history}" -v loaded=",${ALIAZATOR_PLUGINS_ARRAY}," -v one="${_aliazator_stats__files}" '
        FILENAME == hist {
            n = split($0, seg, /&&|\|\||;|\|/)
            for (i = 1; i <= n; i++) {
                s = seg[i]; sub(/^[ \t]+/, "", s)
                m = split(s, w, /[ \t]+/)
                if (w[1] != "") uses[w[1]]++
                if (w[1] == "sudo" && m > 1) uses[w[2]]++
            }
            commands++
            next
        }
        /^[ \t]*alias / {
            name = $0; sub(/^[ \t]*alias (-- )?/, "", name)
            value = name; sub(/=.*/, "", name); sub(/^[^=]*=["\047]?/, "", value)
            sub(/["\047][ \t]*(#.*)?$/, "", value)
            set = FILENAME; sub(/.*\//, "", set); sub(/\.aliases$/, "", set)
            if (!(set in total)) order[++sets] = set
            total[set]++
            if (uses[name] > 0) used[set]++
            if (one != "") printf "%7d  %-12s %s\n", uses[name] + 0, name, substr(value, 1, 58) | "sort -k1,1nr"
        }
        END {
            if (one != "") exit
            printf "%d commands\n\n", commands
            for (i = 1; i <= sets; i++) {
                set = order[i]
                mark = (index(loaded, "," set ",") > 0) ? "+" : " "
                printf " %s%-12s %3d/%d\n", mark, set, used[set] + 0, total[set]
            }
        }' "${_aliazator_stats__history}" "${@}"
}

_aliazator_teach()
{   #the other half of 'stats': an alias you have loaded and have never used.
    #Only from the sets loaded in this shell, because teaching a name nothing
    #here answers to is worse than saying nothing. It runs when you ask it to
    #and never on its own — a shell that lectures you every time you open it
    #stops being a place you want to be
    _aliazator_teach__history="${ETERNALIZE_PATH}"
    [ -r "${_aliazator_teach__history}" ] || _aliazator_teach__history="${HISTFILE:-${HOME}/.bash_history}"
    if [ ! -r "${_aliazator_teach__history}" ]; then
        printf "%s\\n" "aliazator: no readable history (ETERNALIZE_PATH or HISTFILE)" >&2
        return 1
    fi

    _aliazator_teach__n="${1:-1}"
    case "${_aliazator_teach__n}" in
        ''|*[!0-9]*) printf "%s\\n" "aliazator: 'teach [n]' takes a number" >&2; return 1 ;;
    esac

    #awk's srand() seeds from the clock in SECONDS: two calls in the same
    #second would teach you the same alias twice, which is the one thing this
    #must not do. $$ is no good either — the file is sourced, so it is the
    #shell's pid and never changes
    _aliazator_teach__seed=""
    if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
        _aliazator_teach__seed="$(od -An -N3 -tu4 < /dev/urandom 2>/dev/null | tr -d ' 	')"
    fi

    set -- "${ALIAZATOR_PATH}"/default/*.aliases "${ALIAZATOR_PATH}"/extra/*.aliases
    awk -v hist="${_aliazator_teach__history}" -v loaded=",${ALIAZATOR_PLUGINS_ARRAY}," \
        -v want="${_aliazator_teach__n}" -v seed="${_aliazator_teach__seed}" '
        FILENAME == hist {
            #read exactly as stats does: every command position counts, and so
            #does the word after sudo
            n = split($0, seg, /&&|\|\||;|\|/)
            for (i = 1; i <= n; i++) {
                s = seg[i]; sub(/^[ \t]+/, "", s)
                m = split(s, w, /[ \t]+/)
                if (w[1] != "") uses[w[1]]++
                if (w[1] == "sudo" && m > 1) uses[w[2]]++
            }
            next
        }
        /^[ \t]*alias / {
            set = FILENAME; sub(/.*\//, "", set); sub(/\.aliases$/, "", set)
            if (index(loaded, "," set ",") == 0) next
            name = $0; sub(/^[ \t]*alias (-- )?/, "", name)
            value = name; sub(/=.*/, "", name); sub(/^[^=]*=["\047]?/, "", value)
            sub(/["\047][ \t]*(#.*)?$/, "", value)
            if (uses[name] > 0) next
            k = ++unused; nm[k] = name; vl[k] = value; st[k] = set
        }
        END {
            if (unused == 0) { print "aliazator: every loaded alias has earned its keep"; exit }
            if (want > unused) want = unused
            if (seed != "") srand(seed); else srand()
            #a random start and then forward: picking n of them stays linear
            #instead of rolling the dice until it lands on a free slot
            p = int(rand() * unused) + 1
            for (i = 0; i < want; i++) {
                while (seen[p]) p = p % unused + 1
                seen[p] = 1
                printf "  %-12s %-44s (%s)\n", nm[p], substr(vl[p], 1, 44), st[p]
                p = p % unused + 1
            }
            printf "\n%d of your loaded aliases have never been used\n", unused
        }' "${_aliazator_teach__history}" "${@}"
}

_aliazator_suggest_free()
{   #a name is free when nothing in this shell answers to it yet
    [ -z "${1}" ] && return 1
    alias "${1}" >/dev/null 2>&1 && return 1
    command -v "${1}" >/dev/null 2>&1 && return 1
    case ",${_aliazator_suggest__taken}," in *",${1},"*) return 1 ;; esac
    return 0
}

_aliazator_suggest()
{   #the reverse of 'stats': the command shapes repeated in the history that no
    #alias covers yet. Groups by the first two words, so 'git push origin a'
    #and 'git push origin b' are one habit, and proposes a name built from
    #their initials, skipping the ones already taken in this shell. It only
    #prints: paste the lines you want into the custom set (~/.aliases)
    _aliazator_suggest__history="${ETERNALIZE_PATH}"
    [ -r "${_aliazator_suggest__history}" ] || _aliazator_suggest__history="${HISTFILE:-${HOME}/.bash_history}"
    if [ ! -r "${_aliazator_suggest__history}" ]; then
        printf "%s\\n" "aliazator: no readable history (ETERNALIZE_PATH or HISTFILE)" >&2
        return 1
    fi

    _aliazator_suggest__top="${1:-15}"
    case "${_aliazator_suggest__top}" in
        ''|*[!0-9]*) printf "%s\\n" "aliazator: 'suggest [n]' takes a number" >&2; return 1 ;;
    esac

    printf "%s\\n" "history: ${_aliazator_suggest__history}"
    _aliazator_suggest__taken=""
    #alias files first: awk needs to know what is covered before it reads the
    #history. 3 uses is the floor, and a shape under 10 characters saves nothing
    awk -v hist="${_aliazator_suggest__history}" '
        FILENAME != hist {
            if ($0 !~ /^[ \t]*alias /) next
            name = $0; sub(/^[ \t]*alias (-- )?/, "", name)
            value = name; sub(/=.*/, "", name)
            sub(/^[^=]*=["\047]?/, "", value); sub(/["\047][ \t]*(#.*)?$/, "", value)
            covered[name] = 1
            m = split(value, w, /[ \t]+/)
            if (m > 0) shape[(m > 1) ? w[1] " " w[2] : w[1]] = name
            next
        }
        {
            n = split($0, seg, /&&|\|\||;|\|/)
            for (i = 1; i <= n; i++) {
                s = seg[i]; sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s)
                m = split(s, w, /[ \t]+/)
                if (m == 0 || w[1] == "") continue
                f = (w[1] == "sudo" && m > 1) ? 2 : 1
                if (w[f] in covered) continue
                key = (m > f) ? w[f] " " w[f + 1] : w[f]
                if (key in shape) continue
                if (length(key) < 10) continue
                #a quote, a paren or an '=' means this is a fragment of a
                #multi-line entry, not a command the shell ever saw
                if (key ~ /[\047"(\[${}=]/) continue
                uses[key]++
                if (sample[key] == "" || length(s) < length(sample[key])) sample[key] = s
            }
        }
        END { for (k in uses) if (uses[k] >= 3) printf "%d\t%s\t%s\n", uses[k], k, sample[k] }
    ' "${ALIAZATOR_PATH}"/default/*.aliases "${ALIAZATOR_PATH}"/extra/*.aliases \
      "${_aliazator_suggest__history}" | sort -k1,1nr | head -n "${_aliazator_suggest__top}" |
    while IFS="	" read -r _aliazator_suggest__uses _aliazator_suggest__key _aliazator_suggest__sample; do
        #the shape has to start with something this machine can actually run
        command -v "${_aliazator_suggest__key%% *}" >/dev/null 2>&1 || continue

        _aliazator_suggest__one="${_aliazator_suggest__key%% *}"
        _aliazator_suggest__two="${_aliazator_suggest__key#* }"
        [ X"${_aliazator_suggest__two}" = X"${_aliazator_suggest__key}" ] && _aliazator_suggest__two=""
        #a path contributes its last component: ./scripts/run.sh -> run.sh -> r
        #lowercase: a name that needs shift is a name you will not type
        _aliazator_suggest__one="$(printf "%s" "${_aliazator_suggest__one##*/}" | tr -dc 'a-zA-Z0-9' | tr 'A-Z' 'a-z')"
        _aliazator_suggest__two="$(printf "%s" "${_aliazator_suggest__two##*/}" | tr -dc 'a-zA-Z0-9' | tr 'A-Z' 'a-z')"
        _aliazator_suggest__name="$(printf "%.1s%.1s" "${_aliazator_suggest__one}" "${_aliazator_suggest__two}")"

        #a taken name grows by one more letter of the second word, up to 4
        _aliazator_suggest__char="2"
        while ! _aliazator_suggest_free "${_aliazator_suggest__name}"; do
            _aliazator_suggest__next="$(printf "%s" "${_aliazator_suggest__two}" | cut -c"${_aliazator_suggest__char}")"
            if [ -z "${_aliazator_suggest__next}" ] || [ "${_aliazator_suggest__char}" -gt "4" ]; then
                _aliazator_suggest__name=""; break
            fi
            _aliazator_suggest__name="${_aliazator_suggest__name}${_aliazator_suggest__next}"
            _aliazator_suggest__char="$((_aliazator_suggest__char + 1))"
        done

        if [ -z "${_aliazator_suggest__name}" ]; then
            printf "%6d  %-34s #every short name is taken\\n" \
                "${_aliazator_suggest__uses}" "${_aliazator_suggest__key}"
        else
            _aliazator_suggest__taken="${_aliazator_suggest__taken}${_aliazator_suggest__name},"
            printf "%6d  %-34s #e.g. %s\\n" "${_aliazator_suggest__uses}" \
                "alias ${_aliazator_suggest__name}='${_aliazator_suggest__key}'" \
                "${_aliazator_suggest__sample}"
        fi
    done
}

if [ "${#}" -lt "1" ]; then
   _usage
else
    case "${1}" in
        #list|disable|search) _aliazator_$1 "$2";;
        #enable) . $ALIAZATOR_PATH/../bin/aliazator-enable "$2" ;;
        l*) _aliazator_list    "${2}";;
        d*) _aliazator_disable "${2}";;
        st*) _aliazator_stats  "${2}";;
        su*) _aliazator_suggest "${2}";;
        t*) _aliazator_teach   "${2}";;
        s*) _aliazator_search  "${2}";;
        e*) . "${ALIAZATOR_PATH}/../bin/aliazator-enable" "${2}" ;;
        *) _usage ;;
    esac
fi

# vim: set ts=8 sw=4 tw=0 ft=sh :
