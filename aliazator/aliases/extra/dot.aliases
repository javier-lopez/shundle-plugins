#dot, git for the dotfiles repo with $HOME as its work tree (dot lives in learn)
#mirrors git.aliases (g -> d) for what makes sense on $HOME; left out: clone,
#submodule and upstream helpers, and everything dot refuses (add ., reset --hard)
alias d='dot'
alias da='dot add'
alias dall='dot add -u'
alias dsh='dot show'
alias ds='dot status'
alias dst='dot status'
alias dss='dot status -s'
alias ddi='dot diff'
alias ddf='dot diff'
alias dff='dot diff'
alias dds='dot diff --staged'
alias dpl='dot pull'
alias dpu='dot push'
alias dpp='dot pull && dot push'
alias dr='dot reset'
alias drs='dot reset --soft "HEAD^"'
alias dc='dot commit'
alias dca='dot commit --amend'
alias dcm='dot commit -m'
alias dcam='dot commit --amend -m'
alias dcu='dot checkout --'
alias dl='dot log --graph --pretty=oneline --abbrev-commit'
alias dlg="dot log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative"
alias dlp='dot log --graph --pretty=oneline --abbrev-commit -p'
alias dsa='dot sparse-checkout add'
alias dsl='dot sparse-checkout list'
