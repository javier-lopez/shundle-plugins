#git
alias g='git'
alias gcf='_gcf() { git clone --depth=1 "${@}" && cd "$(basename "${1}" ".git")"; }; _gcf'
alias gcl='_gcl() { git clone "${@}" && cd "$(basename "${1}" ".git")"; }; _gcl'
alias ga='git add'
alias gs='git status'
alias gst='git status'
alias gd='git diff'
alias gds='git diff --staged'
alias gps='git push'
alias gpl='git pull'
alias gc='git commit'
alias gca='git commit --amend'
alias gcm='git commit -m'
alias gcam='git commit --amend -m'
alias gb='git branch'
alias gbr='git branch'
alias gco='git checkout'
alias gl='git log --graph --pretty=oneline --abbrev-commit'
alias gll='git log --pretty=full'
alias glg="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative"
alias gls="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative --stat"
alias glp='git log --graph --pretty=oneline --abbrev-commit -p'
alias gmv='git mv'
alias git.submodule.update.all='git submodule foreach git pull'
